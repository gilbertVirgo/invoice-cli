# Company information (sensitive) - fill these out in your local `.env` file
COMPANY_NAME=Your Company Ltd
COMPANY_ADDRESS=1 Example Street
COMPANY_CITY=Townsville
COMPANY_POSTCODE=AB12 3CD
COMPANY_COUNTRY=United Kingdom
COMPANY_PHONE=+44 1234 567890
COMPANY_BANK_NAME=Your Company Ltd
COMPANY_BANK_SORTCODE=00-00-00
COMPANY_BANK_ACCOUNT_NUMBER=00000000
COMPANY_BANK_IBAN=GB00 XXXX 0000 0000 0000 00

# Google Sheets configuration
GOOGLE_SHEET_ID=""

# Service account credentials: either set the path to the JSON file or paste the JSON
# GOOGLE_SERVICE_ACCOUNT_FILE=/full/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={...}
